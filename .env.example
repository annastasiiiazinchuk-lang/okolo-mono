DATABASE_URL=postgresql://postgres:postgres@localhost:5432/okolo_mono

# Monobank
MONO_TOKEN=
WEBHOOK_URL=https://okolo-mono.onrender.com/api/webhooks/monobank
REDIRECT_URL=https://твій-shopify-домен/pages/thank-you

# Monobank Частинами, optional
MONO_PARTS_BASE_URL=https://u2.monobank.com.ua
MONO_PARTS_STORE_ID=
MONO_PARTS_SECRET=
MONO_PARTS_RESULT_CALLBACK_URL=https://okolo-mono.onrender.com/api/webhooks/monobank-parts
MONO_PARTS_COUNTS=3
MONO_PARTS_INVOICE_SOURCE=INTERNET
MONO_PARTS_POINT_ID=
MONO_PARTS_ADMIN_TOKEN=
MONO_PARTS_AUTO_CONFIRM=false
MONO_PARTS_ENABLED=false

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional alias for older env setups. Prefer SHOPIFY_STORE_DOMAIN.
SHOPIFY_STORE_URL=https://your-store.myshopify.com/
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PAYMENT_UPDATE_DELAY_SECONDS=0

# Nova Poshta
NOVA_POSHTA_API_KEY=

# Sitniks CRM
SITNIKS_API_BASE_URL=https://crm.sitniks.com
SITNIKS_API_TOKEN=
SITNIKS_STATUS_ID=
SITNIKS_PAID_STATUS_ID=
SITNIKS_PREPAYMENT_PAID_STATUS_ID=
SITNIKS_PARTS_PAID_STATUS_ID=
SITNIKS_SALES_CHANNEL_ID=
SITNIKS_SETTLEMENT_ACCOUNT_ID=
SITNIKS_SETTLEMENT_ACCOUNT_TITLE=
SITNIKS_WAREHOUSE_ID=
SITNIKS_NOVA_POSHTA_INTEGRATION_ID=
SITNIKS_CASH_REGISTER_ID=
SITNIKS_RECEIPTS_ENABLED=false
SITNIKS_RECEIPT_PAYMENT_TYPE=prepayment
SITNIKS_RECEIPT_VERIFY_ATTEMPTS=6
SITNIKS_RECEIPT_VERIFY_DELAY_MS=5000
# JSON map: Shopify SKU or variant_id -> Sitniks itemId/itemType.
# Example: {"SKU-1":{"itemId":123,"itemType":"variation"}}
SITNIKS_OFFER_MAP=

# Meta Conversions API, optional
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# GA4 Measurement Protocol, optional
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Google Ads direct server-side conversion upload, optional.
# This is separate from GA4 import and needs Google Ads API access.
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Use either GOOGLE_ADS_CONVERSION_ACTION_ID or full resource name.
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_CONVERSION_ACTION_RESOURCE_NAME=

NODE_ENV=development
PORT=3000
